With Wire
    .Reset
    .Name "QFH_Short_Loop"
    .Type "Curvewire"
    .Curve "QFH_Short_Loop:QFH_Short_Loop_path"
    .Radius "1"
    .Material "Copper (annealed)"
    .SolidWireModel "False"
    .Add
End With
With DiscretePort
    .Reset
    .PortNumber "1"
    .Type "SParameter"
    .Impedance "50.0"
    .Monitor "False"
    .SetP1 "False", "-2", "0", "703.536441066"
    .SetP2 "False", "2", "0", "703.536441066"
    .Radius "1"
    .InvertDirection "False"
    .LocalCoordinates "False"
    .Create
End With
ChangeSolverType "HF IntegralEq"
With IESolver
    .UseFastFrequencySweep True
    .SetAccuracySetting "Custom"
    .LowFrequencyStabilization True
    .SetCFIEAlpha "1.0"
    .SetiMoMACC_I "1e-5"
End With
FDSolver.OrderSrf "First"
FDSolver.UseDoublePrecision True
FDSolver.Type "Direct"
FDSolver.AccuracySrf "1e-6"
FDSolver.SetAllowFloatDirectSolver False
FDSolver.StoreAllResults False
FDSolver.ResetSampleIntervals "all"
FDSolver.AddSampleInterval "125", "150", "", "Automatic", False
FDSolver.AddSampleInterval "137.9", "137.9", "1", "Single", False
FDSolver.SetStopSweepIfCriterionMet True
FDSolver.SetSweepThreshold "S-Parameters", 0.001
FDSolver.SetNumberOfResultDataSamples 1001
FDSolver.AddMonitorSamples False
IESolver.LowFrequencyStabilization False
FDSolver.OrderSrf "First"

'@ farfield plot options

'[VERSION]2025.1|34.0.1|20241028[/VERSION]
With FarfieldPlot 
     .Plottype "2DOrtho" 
     .Vary "angle1" 
     .Theta "90" 
     .Phi "90" 
     .Step "5" 
     .Step2 "5" 
     .SetLockSteps "True" 
     .SetPlotRangeOnly "False" 
     .SetThetaStart "0" 
     .SetThetaEnd "180" 
     .SetPhiStart "0" 
     .SetPhiEnd "360" 
     .SetTheta360 "False" 
     .SymmetricRange "False" 
     .SetTimeDomainFF "False" 
     .SetFrequency "-1" 
     .SetTime "0" 
     .SetColorByValue "True" 
     .DrawStepLines "False" 
     .DrawIsoLongitudeLatitudeLines "False" 
     .ShowStructure "False" 
     .ShowStructureProfile "False" 
     .SetStructureTransparent "False" 
     .SetFarfieldTransparent "False" 
     .AspectRatio "Free" 
     .ShowGridlines "True" 
     .InvertAxes "False", "False" 
